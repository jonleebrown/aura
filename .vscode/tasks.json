{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Aurora Firmware",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build-aurora.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Stage Aurora Firmware on USB",
            "type": "process",
            "command": "${workspaceFolder}/scripts/stage-aurora-firmware.sh",
            "args": [
                "${input:auroraUsbMount}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build & Flash Aurora Firmware",
            "type": "process",
            "command": "${workspaceFolder}/scripts/flash-aurora-dfu.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build & Stage Aurora Firmware",
            "dependsOn": [
                "Build Aurora Firmware",
                "Stage Aurora Firmware on USB"
            ],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Install VST3",
            "type": "process",
            "command": "${workspaceFolder}/scripts/build-vst.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "auroraUsbMount",
            "type": "promptString",
            "description": "Path of the mounted Aurora USB volume",
            "default": "/Volumes/AURORA"
        }
    ]
}
