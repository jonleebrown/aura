  40:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****     struct Config
  41:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****     {
  42:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****         /** Selected Media that will be linked to FatFS 
  43:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  These values can be OR'd together when multiple
  44:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  volumes are desired 
  45:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  i.e. config.media = Media::SD | Media::USBH;
  46:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          * 
  47:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  When mounting multiple volumes, ffconf.h must have 
  48:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  _VOLUMES set to an appropriate value.
  49:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          * 
ARM GAS  /var/folders/5k/4f4bd4s53799x6g80pw__chw0000gn/T//ccdRCr6Q.s 			page 152


  50:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****          *  FatFS will register multiple volumes in the order of the enum,
