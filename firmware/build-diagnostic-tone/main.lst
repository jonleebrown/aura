   8:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h **** /** @brief Daisy FatFS Driver Interface
   9:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *  @details Specifies the desired media (SD Card, USB, etc.) to be mountable with FatFS
  10:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           within a given application. Once initialization is called, the standard
  11:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           FatFS API will be usable with the media mounted in the order 
  12:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           they are listed in the Media config struct. 
  13:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           For example, when only using an SD Card, it will mount at "0:/",
  14:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           when only using USB, it will mount at "0:/". However, when mounting 
  15:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           with SD card and USB, the SD card will mount at "0:/", and the USB 
  16:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           will mount at "1:/".
  17:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           The relevant hardware peripheral (SDMMC, or MSD) needs to be initialized
  18:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           separately by the application before using FatFS.
  19:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *          
  20:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           This object has some memory limitations due to the media connected to it.
  21:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           The SDMMC1 peripheral can only communicate with the AXI SRAM, and the DTCMRAM 
  22:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           cannot communicate with the DMA. So the FatFSInterface object should always be
  23:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           located in the AXI SRAM. This is the default location for all data/bss memory
  24:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           using the standard build. However, applciations using the electrosmith bootloader
  25:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  *           will need special consideration when using this object AND an SD Card. 
  26:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****  */
  27:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h **** class FatFSInterface
  28:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h **** {
