 468:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/include/aurora.h ****     /** @brief starts the mounting process for USB Drive use if it is present
 469:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/include/aurora.h ****      *
 470:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/include/aurora.h ****      *  To access files from a USB drive: the connect, class_active, and disconnect
