  32:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****     {
  33:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****         OK,
  34:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****         ERR_TOO_MANY_VOLUMES,
  35:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****         ERR_NO_MEDIA_SELECTED,
  36:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****         ERR_GENERIC,
  37:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h ****     };
  38:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/sys/fatfs.h **** 
