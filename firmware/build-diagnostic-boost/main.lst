  25:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****     /** Uses the values retrieved for 1V and 3V in order to compute
  26:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  a scale and offset value that can be used to convert a CV input 
  27:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  signal to a calibrated 1V/oct range. 
  28:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      * 
  29:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  \param val1V ADC reading for 1 volt
  30:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  \param val3V ADC reading for 3 volts
  31:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  \retval returns true if the calibraiton is successful - this is always true
  32:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      * 
  33:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *  \todo Add some sort of range validation. Originally we had a check
  34:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *        for a valid range on the input, but given that the input circuit
  35:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *        or the AnalogControl configuration can have a drastic effect on
  36:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *        input, that could cause unintentional failure to calibrate, 
  37:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      *        it was removed.
  38:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****      **/
  39:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****     bool Record(float val1V, float val3V)
  40:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****     {
  41:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****         float delta = val3V - val1V;
  42:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****         scale_      = 24.f / delta;
  43:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****         offset_     = 12.f - scale_ * val1V;
  44:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****         cal_        = true;
  45:/Users/jonathanbrown/Documents/dev/aura/lib/Aurora-SDK/libs/libDaisy//src/util/VoctCalibration.h ****         return cal_;
